#!/bin/bash
# One shot: fill config -> doctor -> arm the next session -> schedule wake -> status.
# You type the account number, the tickers and the ARM confirmation; nothing is guessed.
# Usage: ./bin/arm-tomorrow [YYYY-MM-DD]
set -euo pipefail
DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$DIR"
LOADER="file://$DIR/node_modules/tsx/dist/loader.mjs"
CFG="${FIFTY_CONFIG:-$DIR/config/fifty.json}"
[ -d node_modules ] || { echo "Installing pinned dependencies (npm ci --ignore-scripts)..."; npm ci --ignore-scripts --no-audit --no-fund; }

# Sign-in: FIFTY_TOKEN_PATH if set, else Fifty's own (~/.config/fifty), else an existing
# fall_forward_labs sign-in; if none exists, sign in now (opens Robinhood in the browser).
if [ -z "${FIFTY_TOKEN_PATH:-}" ]; then
  if [ -f "$HOME/.config/fifty/robinhood-oauth.json" ]; then FIFTY_TOKEN_PATH="$HOME/.config/fifty/robinhood-oauth.json"
  elif [ -f "$HOME/.config/fall_forward_labs/robinhood-oauth.json" ]; then FIFTY_TOKEN_PATH="$HOME/.config/fall_forward_labs/robinhood-oauth.json"
  else FIFTY_TOKEN_PATH="$HOME/.config/fifty/robinhood-oauth.json"; fi
fi
export FIFTY_TOKEN_PATH
if [ ! -f "$FIFTY_TOKEN_PATH" ]; then
  echo "No Robinhood sign-in yet. Opening Robinhood sign-in in your browser; finish Agentic onboarding there."
  ./bin/fifty login
fi
[ -f "$CFG" ] || cp config/fifty.example.json "$CFG"

DATE="${1:-$(node --import "$LOADER" -e '
import("./src/calendar.ts").then((c) => {
  const d = c.nyDate(Date.now()), s = c.sessionOn(d);
  console.log(s && Date.now() < s.openMs - 35 * 60e3 ? d : c.nextSessionAfter(d).date);
});')}"
echo "Session to arm: $DATE"

echo
echo "Your Agentic account number: Robinhood app > Agentic account > Settings > Account information."
echo "(letters/digits only; input hidden; Enter keeps current; doctor rejects a number that is not your agentic account):"
read -r -s ACCT
echo
echo "Tickers it may trade, comma separated (e.g. XYZ,QRS)."
echo "Or press Enter to let the strategy choose each morning from Robinhood's \"Daily movers\" + \"Trending stocks\" lists:"
read -r TICKERS

ACCT="$ACCT" TICKERS="$TICKERS" python3 - "$CFG" config/fifty.example.json <<'EOF'
import json, os, re, sys
path = sys.argv[1]
c = json.load(open(path))
example = json.load(open(sys.argv[2]))
def fill(dst, src):  # add settings introduced after this config was copied
    for k, v in src.items():
        if k not in dst: dst[k] = v
        elif isinstance(v, dict) and isinstance(dst[k], dict): fill(dst[k], v)
fill(c, example)
acct = os.environ["ACCT"].strip()
if acct:
    c["boundaries"]["account_number"] = acct
acct = c["boundaries"]["account_number"]
if not re.fullmatch(r"[A-Za-z0-9]+", acct) or "REPLACE" in acct or acct == "YOUR_FULL_NUMBER":
    sys.exit("account number must be letters/digits only (no spaces, dashes or placeholders)")
PLACEHOLDERS = {"REPLACE", "WITH", "YOUR", "SYMBOLS", "AAA", "BBB", "CCC"}
t = [s.strip().upper() for s in os.environ["TICKERS"].split(",") if s.strip()]
if t:
    c["universe"], c["universe_lists"] = t, []
else:
    c["universe"] = [s for s in c["universe"] if s not in PLACEHOLDERS]
    if not c["universe"] and not c["universe_lists"]:
        c["universe_lists"] = example["universe_lists"]
bad = [s for s in c["universe"] if not re.fullmatch(r"[A-Z][A-Z0-9.]{0,9}", s) or s in PLACEHOLDERS]
if bad:
    sys.exit(f"invalid tickers: {bad}")
with open(path, "w") as f:
    json.dump(c, f, indent=2)
    f.write("\n")
os.chmod(path, 0o600)
src = ", ".join(c["universe"] + [f'Robinhood list "{l}"' for l in c["universe_lists"]])
print(f"config saved: account ••••{acct[-4:]}, universe {src}")
EOF

echo
echo "== doctor (read-only) =="
./bin/fifty doctor --date "$DATE" || { echo; echo "Doctor failed; fix the FAIL lines above and re-run ./bin/arm-tomorrow"; exit 1; }

echo
echo "== arm =="
./bin/fifty arm-session --date "$DATE"

WAKE="$(node --import "$LOADER" -e '
import("./src/calendar.ts").then((c) => {
  const d = new Date(c.sessionOn(process.argv[1]).openMs - 40 * 60e3), p = (n) => String(n).padStart(2, "0");
  console.log(`${p(d.getMonth() + 1)}/${p(d.getDate())}/${d.getFullYear()} ${p(d.getHours())}:${p(d.getMinutes())}:00`);
});' "$DATE")"
echo
echo "== scheduling wake at $WAKE (local time; asks for your Mac password) =="
sudo pmset schedule wake "$WAKE" || echo "Wake not scheduled. Keep the Mac awake, plugged in, lid open."

echo
./bin/fifty status
echo
echo "Armed for $DATE. Leave the Mac plugged in with the lid open. Watch: ./bin/fifty status   Kill: ./bin/fifty stop --flatten"
